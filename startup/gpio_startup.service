[Unit]
Description=FYP Project GPIO startup
After=multi-user.target

[Service]
Type=simple
User=go2
WorkingDirectory=/home/go2/Real-Time-Trajectory-Prediction-and-Response-for-Quadruped-Robot
Environment=PYTHONPATH=/home/go2/Real-Time-Trajectory-Prediction-and-Response-for-Quadruped-Robot
ExecStart=/home/go2/Real-Time-Trajectory-Prediction-and-Response-for-Quadruped-Robot/hailo-apps/venv_hailo_apps/bin/python -m startup.start_script
Restart=always

[Install]
WantedBy=multi-user.target