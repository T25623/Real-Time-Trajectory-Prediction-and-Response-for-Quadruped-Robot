[Unit]
Description=FYP Project GPIO startup
After=multi-user.target

[Service]
Type=simple
User=go2
WorkingDirectory=/home/go2/Real-Time-Trajectory-Prediction-and-Response-for-Quadruped-Robot
ExecStart=/usr/bin/python3 /home/go2/Real-Time-Trajectory-Prediction-and-Response-for-Quadruped-Robot/startup/start_script.py
Restart=always

[Install]
WantedBy=multi-user.target